#!/usr/bin/env bash
# limousine — launch the limousine server container, mounting your workspace,
# docker socket, and the usual auth/config dirs.
#
# Usage:
#   limousine /abs/path/to/foo.wksp                              # serve, auto-open
#   limousine                                                    # pick wksp in UI
#   limousine --lan /abs/path/foo.wksp                           # bind to 0.0.0.0
#   limousine --clone-root /abs/path/projects /abs/path/foo.wksp # re-root clones
#
# Env overrides:
#   LIMOUSINE_IMAGE                default ghcr.io/pattern-agentic/limousine:latest
#   LIMOUSINE_PORT                 default 7891   — main HTTP port
#   LIMOUSINE_MCP_PORT             default 6891   — MCP server port
#   LIMOUSINE_MOUNT_ROOT           override the host directory bind-mounted
#                                  into the container.
#   LIMOUSINE_AGE_KEY              if set, bypasses the interactive prompt
#                                  (must be a `AGE-SECRET-KEY-…` value).
#   LIMOUSINE_NO_KEY_PROMPT        set to 1 to start with no age key (secret
#                                  store stays locked, sops-encrypted secrets
#                                  cannot be decrypted by services).

set -euo pipefail

IMAGE="${LIMOUSINE_IMAGE:-ghcr.io/pattern-agentic/limousine:latest}"
PORT="${LIMOUSINE_PORT:-7891}"
MCP_PORT="${LIMOUSINE_MCP_PORT:-6891}"

LAN=0
WORKSPACE=""
CLONE_ROOT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --lan) LAN=1; shift ;;
    --clone-root)
      CLONE_ROOT="${2:-}"
      if [ -z "$CLONE_ROOT" ]; then
        echo "error: --clone-root needs a directory argument" >&2
        exit 2
      fi
      shift 2 ;;
    --clone-root=*) CLONE_ROOT="${1#--clone-root=}"; shift ;;
    -h|--help)
      sed -n '2,18p' "$0" | sed 's/^# *//'
      exit 0 ;;
    --) shift; WORKSPACE="${1:-}"; shift || true ;;
    -*) echo "error: unknown flag $1" >&2; exit 2 ;;
    *) WORKSPACE="$1"; shift ;;
  esac
done

if ! command -v docker >/dev/null 2>&1; then
  echo "error: docker is required" >&2
  exit 1
fi

abs_path() {
  if command -v readlink >/dev/null 2>&1 && readlink -f / >/dev/null 2>&1; then
    readlink -f "$1"
  else
    # macOS: readlink -f isn't available
    python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "$1"
  fi
}

if [ -n "$WORKSPACE" ]; then
  WORKSPACE_ABS="$(abs_path "$WORKSPACE")"
  DEFAULT_MOUNT="$(dirname "$WORKSPACE_ABS")"
else
  WORKSPACE_ABS=""
  DEFAULT_MOUNT="$(pwd)"
fi

MOUNT_ROOT="${LIMOUSINE_MOUNT_ROOT:-$DEFAULT_MOUNT}"
MOUNT_ROOT="$(abs_path "$MOUNT_ROOT")"

CLONE_ROOT_ABS=""
if [ -n "$CLONE_ROOT" ]; then
  # Create the clone-root if missing so first-time bootstrap is friction-free.
  mkdir -p "$CLONE_ROOT"
  CLONE_ROOT_ABS="$(abs_path "$CLONE_ROOT")"
fi

# -- Age private key prompt --------------------------------------------------
# Read once, interactively, with no echo. Empty input → secret store stays
# locked at startup; sops-encrypted secrets won't be decryptable until you
# restart with the right key. The key never touches disk: held only in the
# wrapper's shell and in the server process's memory.
if [ -z "${LIMOUSINE_AGE_KEY:-}" ] && [ "${LIMOUSINE_NO_KEY_PROMPT:-0}" != "1" ]; then
  if [ -t 0 ]; then
    printf 'Age private key (paste AGE-SECRET-KEY-…, no echo, enter to skip): ' >&2
    IFS= read -rs LIMOUSINE_AGE_KEY || true
    echo >&2
    export LIMOUSINE_AGE_KEY
  else
    echo "stdin not a tty — set LIMOUSINE_AGE_KEY or LIMOUSINE_NO_KEY_PROMPT=1" >&2
    exit 2
  fi
fi

# -- Bind host --------------------------------------------------------------
BIND_HOST="127.0.0.1"
if [ "$LAN" = "1" ]; then
  BIND_HOST="0.0.0.0"
  echo "⚠  --lan: binding to 0.0.0.0. Secret values are still gated by your"  >&2
  echo "    age private key in the Authorization header, but anyone on the LAN" >&2
  echo "    who has that key can read the decrypted values. Service terminals"  >&2
  echo "    are NOT gated."                                                      >&2
fi

# -- docker run args --------------------------------------------------------
ARGS=(--rm)
[ -t 0 ] && ARGS+=(-it) || ARGS+=(-i)

ARGS+=(--name "limousine-${PORT}")
# Bind both the main port and the MCP port to BIND_HOST explicitly.
ARGS+=(-p "${BIND_HOST}:${PORT}:${PORT}" -p "${BIND_HOST}:${MCP_PORT}:${MCP_PORT}")

ARGS+=(--user "$(id -u):$(id -g)")

if [ "$(uname -s)" = "Linux" ] && [ -S /var/run/docker.sock ]; then
  ARGS+=(--group-add "$(stat -c %g /var/run/docker.sock)")
fi

ARGS+=(-v /var/run/docker.sock:/var/run/docker.sock)
ARGS+=(-v "${MOUNT_ROOT}:${MOUNT_ROOT}")
# Bind the clone-root at the same path inside the container so service
# subprocesses that do `docker run -v "$PWD:/data"` keep working.
if [ -n "$CLONE_ROOT_ABS" ] && [ "$CLONE_ROOT_ABS" != "$MOUNT_ROOT" ]; then
  ARGS+=(-v "${CLONE_ROOT_ABS}:${CLONE_ROOT_ABS}")
fi
[ -d "$HOME/.aws"           ] && ARGS+=(-v "$HOME/.aws:$HOME/.aws")
[ -d "$HOME/.kube"          ] && ARGS+=(-v "$HOME/.kube:$HOME/.kube")
[ -d "$HOME/.config/gcloud" ] && ARGS+=(-v "$HOME/.config/gcloud:$HOME/.config/gcloud")
[ -d "$HOME/.ssh"           ] && ARGS+=(-v "$HOME/.ssh:$HOME/.ssh:ro")
[ -d "$HOME/.docker"        ] && ARGS+=(-v "$HOME/.docker:$HOME/.docker:ro")
[ -f "$HOME/.gitconfig"     ] && ARGS+=(-v "$HOME/.gitconfig:$HOME/.gitconfig:ro")

# SSH agent forwarding. The mechanism differs by host OS:
#   Linux  → bind-mount the host's actual socket. Sockets traverse the bind.
#   macOS  → use Docker Desktop's `/run/host-services/ssh-auth.sock` magic
#           path. The real macOS ssh-agent socket can't be bind-mounted into
#           the Linux VM (sockets don't cross the VM boundary). We mount this
#           unconditionally on macOS — launchd manages the agent system-wide,
#           and a terminal session not having SSH_AUTH_SOCK exported is no
#           signal that there's nothing to forward.
case "$(uname -s)" in
  Darwin)
    ARGS+=(--mount "type=bind,src=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock")
    ARGS+=(-e "SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock")
    # Docker Desktop creates this socket as root:root mode 0660. Our
    # non-root container user (uid = host uid, e.g. 501) needs the root
    # supplementary group to open it.
    ARGS+=(--group-add "0")
    ;;
  *)
    if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
      ARGS+=(-v "${SSH_AUTH_SOCK}:${SSH_AUTH_SOCK}")
      ARGS+=(-e "SSH_AUTH_SOCK=${SSH_AUTH_SOCK}")
    fi
    ;;
esac

ARGS+=(-e "HOME=$HOME")
# Force the docker CLI inside the container to use the socket we bind-mount
# at /var/run/docker.sock, ignoring any `currentContext` from ~/.docker/
# config.json (Docker Desktop on macOS points its desktop-linux context at
# a host-side path that doesn't exist inside the container).
ARGS+=(-e "DOCKER_HOST=unix:///var/run/docker.sock")
# Pass the age private key through. Empty string = no key / store locked.
# Limousine server reads LIMOUSINE_AGE_KEY at startup and forwards it as
# SOPS_AGE_KEY into each spawned service (so `sops exec-env` can decrypt).
ARGS+=(-e "LIMOUSINE_AGE_KEY=${LIMOUSINE_AGE_KEY:-}")

# -- Server CLI args --------------------------------------------------------
SERVER_ARGS=(--host 0.0.0.0 --port "$PORT")   # inside-container always 0.0.0.0; host-side binding is enforced via -p
[ -n "$WORKSPACE_ABS" ] && SERVER_ARGS+=(--workspace "$WORKSPACE_ABS")
[ -n "$CLONE_ROOT_ABS" ] && SERVER_ARGS+=(--clone-root "$CLONE_ROOT_ABS")

echo "▶ ${IMAGE}"
echo "  http://${BIND_HOST}:${PORT}    (UI)"
echo "  http://${BIND_HOST}:${MCP_PORT}/mcp (MCP, if enabled)"
echo "  mounting ${MOUNT_ROOT}"
[ -n "$WORKSPACE_ABS" ] && echo "  workspace ${WORKSPACE_ABS}"
[ -n "$CLONE_ROOT_ABS" ] && echo "  clone root ${CLONE_ROOT_ABS}"
[ -z "${LIMOUSINE_AGE_KEY:-}" ] && echo "  secret store: locked (no age key supplied)"

exec docker run "${ARGS[@]}" "$IMAGE" "${SERVER_ARGS[@]}"
